rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true ||
        request.auth.token.email == 'patelrishabh82051@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity validation helpers
    function isValidSlot(data) {
      return data.keys().hasAll(['id', 'floor', 'zone', 'status', 'pricePerHour']) &&
        data.keys().hasOnly(['id', 'floor', 'zone', 'status', 'pricePerHour', 'type', 'updatedAt']) &&
        data.id is string && data.id.size() <= 64 &&
        data.floor is string && data.floor.size() <= 16 &&
        data.zone is string && data.zone.size() <= 32 &&
        data.status in ['free', 'reserved', 'occupied', 'disabled'] &&
        data.pricePerHour is number && data.pricePerHour >= 0 &&
        (!('type' in data) || data.type in ['standard', 'ev', 'handicap', 'vip']);
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['id', 'userId', 'slotId', 'vehicleNo', 'startTime', 'endTime', 'status', 'amount', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'slotId', 'vehicleNo', 'startTime', 'endTime', 'status', 'amount', 'createdAt', 'qrData', 'extendedCount']) &&
        data.id is string && data.id.size() <= 64 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.slotId is string && data.slotId.size() <= 64 &&
        data.vehicleNo is string && data.vehicleNo.size() >= 2 && data.vehicleNo.size() <= 32 &&
        data.startTime is number &&
        data.endTime is number && data.endTime > data.startTime &&
        data.status in ['upcoming', 'active', 'completed', 'cancelled'] &&
        data.amount is number && data.amount >= 0 &&
        data.createdAt is number;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'name', 'role']) &&
        data.keys().hasOnly(['uid', 'name', 'email', 'role']) &&
        data.uid is string && data.uid.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.role in ['driver', 'admin'];
    }

    function isValidEntryExitLog(data) {
      return data.keys().hasAll(['id', 'vehicleNo', 'slotId', 'entryTime', 'status']) &&
        data.keys().hasOnly(['id', 'bookingId', 'vehicleNo', 'slotId', 'entryTime', 'exitTime', 'feeCollected', 'status']) &&
        data.id is string && data.id.size() <= 64 &&
        data.vehicleNo is string && data.vehicleNo.size() <= 32 &&
        data.slotId is string && data.slotId.size() <= 64 &&
        data.entryTime is number &&
        data.status in ['inside', 'exited'];
    }

    // Slots collection: Public read for real-time occupancy map, admin-only writes
    match /slots/{slotId} {
      allow get, list: if true;
      allow create: if isAdmin() && isValidId(slotId) && isValidSlot(incoming()) && incoming().id == slotId;
      allow update: if (
        isAdmin() && isValidId(slotId) && isValidSlot(incoming()) && incoming().id == existing().id
      );
      allow delete: if isAdmin() && isValidId(slotId);
    }

    // Bookings collection: Drivers read and manage their own, admins manage all
    match /bookings/{bookingId} {
      allow get: if isSignedIn() && isValidId(bookingId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      
      // Drivers can create booking for themselves; server transaction enforces non-overlapping slot allocation
      allow create: if isSignedIn() && isValidId(bookingId) && isValidBooking(incoming()) && (
        incoming().userId == request.auth.uid || isAdmin()
      );

      // Driver can cancel or extend their own booking; admin can override
      allow update: if isSignedIn() && isValidId(bookingId) && isValidBooking(incoming()) && (
        isAdmin() || (
          existing().userId == request.auth.uid &&
          incoming().userId == existing().userId &&
          incoming().slotId == existing().slotId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'endTime', 'amount', 'extendedCount'])
        )
      );

      allow delete: if isAdmin() && isValidId(bookingId);
    }

    // User profiles: Isolated read/write
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      // On registration, normal users can only set role to 'driver'. Admins can assign roles.
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUserProfile(incoming()) && (
        incoming().role == 'driver' || isAdmin()
      );
      allow update: if isSignedIn() && (
        isAdmin() || (
          request.auth.uid == userId &&
          incoming().uid == existing().uid &&
          incoming().role == existing().role &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email']) &&
          isValidUserProfile(incoming())
        )
      );
      allow delete: if isAdmin();
    }

    // Entry & Exit audit logs: Guarded for administrative barrier control
    match /entryExitLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
